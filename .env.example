# RecoveryAI local environment (plan Section 2.10 / 4.6).
#
# Copy to .env and adjust only if you need to. Every value here is a safe local
# default: the whole system runs with no external credentials and no paid APIs.
# All secrets in this file are obviously-fake development values.

# ---------------------------------------------------------------- environment
ENVIRONMENT=local
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=false
ENABLE_DIAGNOSTICS_ROUTES=true
# DIAGNOSTICS_DOWNSTREAM_URL is deliberately NOT set here: it is per-service, and
# scripts/dev.sh sets it only for auth-service (-> verification-service). Setting it
# globally would make every service call itself.

# ------------------------------------------------------------------ telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_ENABLED=true

# ------------------------------------------------------------------- postgres
# One logical database per service; no service reads another's tables.
POSTGRES_USER=recoveryai
POSTGRES_PASSWORD=recoveryai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

AUTH_DATABASE_URL=postgresql://recoveryai:recoveryai@localhost:5432/recoveryai_auth
IDENTITY_DATABASE_URL=postgresql://recoveryai:recoveryai@localhost:5432/recoveryai_identity
CLAIMS_DATABASE_URL=postgresql://recoveryai:recoveryai@localhost:5432/recoveryai_claims
EVIDENCE_DATABASE_URL=postgresql://recoveryai:recoveryai@localhost:5432/recoveryai_evidence
INBOX_DATABASE_URL=postgresql://recoveryai:recoveryai@localhost:5432/recoveryai_inbox
FILING_GATEWAY_DATABASE_URL=postgresql://recoveryai:recoveryai@localhost:5432/recoveryai_filing_gateway
INSURER_SANDBOX_DATABASE_URL=postgresql://recoveryai:recoveryai@localhost:5432/recoveryai_insurer_sandbox
REGULATOR_SANDBOX_DATABASE_URL=postgresql://recoveryai:recoveryai@localhost:5432/recoveryai_regulator_sandbox
VERIFICATION_DATABASE_URL=postgresql://recoveryai:recoveryai@localhost:5432/recoveryai_verification
AGENT_DATABASE_URL=postgresql://recoveryai:recoveryai@localhost:5432/recoveryai_agent

# -------------------------------------------------------------- object storage
OBJECT_STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=recoveryai
MINIO_ROOT_PASSWORD=recoveryai-dev-secret
MINIO_EVIDENCE_BUCKET=recoveryai-evidence
MINIO_DOCUMENTS_BUCKET=recoveryai-documents
MINIO_FILINGS_BUCKET=recoveryai-filings

# ------------------------------------------------------------- service ports
AUTH_SERVICE_PORT=3001
IDENTITY_SERVICE_PORT=3002
CLAIMS_SERVICE_PORT=3003
EVIDENCE_SERVICE_PORT=3004
RECOVERY_INBOX_SERVICE_PORT=3005
FILING_GATEWAY_PORT=3006
INSURER_SANDBOX_SERVICE_PORT=3007
REGULATOR_SANDBOX_SERVICE_PORT=3008
VERIFICATION_SERVICE_PORT=8001
AGENT_SERVICE_PORT=8002
PLATFORM_WEB_PORT=3000
INSURER_SANDBOX_WEB_PORT=3010
REGULATOR_SANDBOX_WEB_PORT=3011

# ----------------------------------------------------------------- providers
# Deterministic local adapters. Real providers are optional, never required.
KYC_PROVIDER=mock
DISASTER_PROVIDER=mock
GEOCODER_PROVIDER=mock
IMAGE_ANALYSIS_PROVIDER=mock
LLM_PROVIDER=mock
EMAIL_PROVIDER=console
INSURER_ADAPTER=sandbox

# ------------------------------------------------------------------- filing
# The platform files on the user's behalf after in-app approval (plan Section 11).
# Local and CI runs may only ever reach the sandboxes.
FILING_MODE=agent_files
FILING_ADAPTER_INSURER=sandbox
FILING_ADAPTER_AUTHORITY=sandbox
ESIGN_PROVIDER=local
